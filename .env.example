SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SITE_ORIGIN=https://joinpawsforward.com
# Mirror supabase + siteOrigin in js/config.js (contact emails, commissionRate, sitePin).
# Operator PIN is set in js/config.js as sitePin (4 digits), e.g. 4821
#
# Stripe + deploy helpers (kept in .env for Edge Function secrets / CLI deploy):
STRIPE_PUBLISHABLE_KEY=pk_live_or_test_...
STRIPE_SECRET_KEY=sk_live_or_rk_live_...
STRIPE_PRICE_ID=price_...
STRIPE_PROMO_ID=promo_...
SUPABASE_ACCESS_TOKEN=sbp_...
VERCEL_TOKEN=vcp_...
# Also store the secret in private.app_secrets key=stripe_secret_key (service_role only)
# or set Edge Function secret STRIPE_SECRET_KEY in the Supabase dashboard.
#
# Welcome email (send-promoter-welcome Edge Function):
# RESEND_API_KEY=re_...
# RESEND_FROM=Paws Forward <joinpawsforward@outlook.com>
# Or store private.app_secrets key=resend_api_key
