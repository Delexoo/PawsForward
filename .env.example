SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
# Mirror these values in js/config.js (siteOrigin, contact emails, commissionRate).
# Operator PIN is set in js/config.js as sitePin (4 digits), e.g. 4821
#
# Stripe (Edge Functions create-checkout / confirm-donation):
# Store the secret in private.app_secrets key=stripe_secret_key (service_role only)
# or set Edge Function secret STRIPE_SECRET_KEY in the Supabase dashboard.
